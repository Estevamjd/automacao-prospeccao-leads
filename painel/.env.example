# Copie para .env.local e preencha com os valores do SEU projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# Somente servidor. NUNCA prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
N8N_WEBHOOK_SECRET=defina-um-segredo
DEFAULT_LLM_PROVIDER=none
USE_AI_AGENT_RUNNER=false
CONTATO_EMAIL=voce@exemplo.com
